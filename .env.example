# Supabase connection — copy to .env.local and fill in.
# Find these in the Supabase dashboard: Project Settings > API.
# Both are also set as environment variables in Vercel (all environments).
# The anon key is public by design (ships in the browser bundle, protected by RLS).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
